{% extends 'base.html.twig' %}

{% block title %}Incidencias{% endblock %}

{% block body %}

    <h1>Incidencias</h1>

    <p>Total: {{ tickets|length }}</p>

    <ul>
        {% for ticket in tickets %}
            <li>
                {{ ticket.id }} -
                Título: {{ ticket.title }} -
                Prioridad: {{ ticket.priority }} -
                Estado: {{ ticket.status }}
            </li>
        {% endfor %}
    </ul>

{% endblock %}