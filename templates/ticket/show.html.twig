{% extends "base.html.twig" %}

{% block title %}{{ ticket.title }}{% endblock %}

{% block body %}

    <div class="page-header">

        <div>

            <p class="eyebrow">IssueFlow</p>

            <h1>{{ ticket.title }}</h1>

        </div>

    </div>

    <div class="ticket-card">

        <p class="ticket-id">{{ ticket.id }}</p>

        <p>Prioridad: <strong>{{ ticket.priority.label }}</strong></p>

        <p>Estado: <strong>{{ ticket.status.label }}</strong></p>
{# Agregamos el mensaje "Requiere atencion inmediata" solo si el
     ticket tiene una prioridad Urgente::Urgent
      #}
     {% if ticket.urgent %}
     <p class="ticket-urgent">Requiere atencion inmediata </p>
     {% endif %}
    {% endblock %}