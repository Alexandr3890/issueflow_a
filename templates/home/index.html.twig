        <div>
            <p class="eyebrow">{{ projectName }}</p>
            <h1>Bienvenido a {{ projectName }}</h1>
        </div>
    </div>

    <section class="filter-card">
        <h2>Panel principal</h2>

        <p>{{ message }}</p>

        <a href="{{ path('app_ticket_index') }}"
           class="button">
            Consultar incidencias
        </a>
    </section>
{% endblock %}