{% extends "base.html.twig" %}

{% block title %}{{ ticket.title }}{% endblock %}

{% block body %}

    <div class="page-header">

        <div>

            <p class="eyebrow">IssueFlow</p>

            <h1>{{ ticket.title }}</h1>

        </div>

    </div>

    <div class="ticket-card">

        <p class="ticket-id">{{ ticket.id }}</p>

        <p>Prioridad: <strong>{{ ticket.priority }}</strong></p>

        <p>Estado: <strong>{{ ticket.status }}</strong></p>

    </div>

{% endblock %}